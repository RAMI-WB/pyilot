<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تسجيل الدخول | Pyilot 🐍</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">🐍</div>
    <h1 class="auth-title">Pyilot</h1>
    <p class="auth-subtitle">تعلّم البرمجة بالعربية 🚀</p>

    <% if (error) { %>
    <div class="error-alert"><%= error %></div>
    <% } %>

    <form action="/login" method="POST" class="auth-form">
      <div class="form-group">
        <label>البريد الإلكتروني</label>
        <input type="email" name="email" placeholder="example@email.com" required>
      </div>
      <div class="form-group">
        <label>كلمة المرور</label>
        <input type="password" name="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn-primary">دخول →</button>
    </form>

    <p class="auth-switch">ليس لديك حساب؟ <a href="/register">سجّل الآن</a></p>
  </div>
</div>
</body>
</html>
