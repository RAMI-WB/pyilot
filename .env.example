# قاعدة البيانات - انسخ الرابط من Render أو Supabase
DATABASE_URL=postgresql://user:password@host:5432/dbname

# مفتاح الجلسة - اختر كلمة سرية عشوائية طويلة
SESSION_SECRET=your_super_secret_key_change_this_in_production

# بيئة التشغيل
NODE_ENV=production

# المنفذ (Render يضبطه تلقائياً)
PORT=3000
